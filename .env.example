# PostgreSQL. Use localhost when running scripts from the host,
# and the service name "postgres" when running inside docker compose.
DATABASE_URL="postgresql://seo_user:CHANGE_ME@localhost:5432/seo_db?schema=public"
POSTGRES_PASSWORD="CHANGE_ME"

# AWS credentials for the S3 ETL buckets
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# Written by: npm run aws:buckets
AWS_BUCKET_DOCTORS=""
AWS_BUCKET_BROADBAND=""
AWS_BUCKET_DEMOGRAPHICS=""
AWS_BUCKET_ENERGY=""
AWS_BUCKET_EXECUTIVES=""
AWS_BUCKET_TRUCKING=""
AWS_BUCKET_AIRCRAFT=""
AWS_BUCKET_NUTRITION=""
AWS_BUCKET_CLIMATE=""
AWS_BUCKET_TRADEMARK=""

# Site identity. NEXT_PUBLIC_ALLOW_INDEXING must be "true" in production —
# robots.txt disallows everything while it is not.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="US Open Data Directory"
NEXT_PUBLIC_ALLOW_INDEXING="false"

# SEC blocks requests without a contact address in the user agent.
SEC_CONTACT="your-project you@example.com"

# Blocked datasets: see docs/DATA_SOURCES.md
CENSUS_API_KEY=""
EIA_API_KEY=""
USPTO_API_KEY=""

# IndexNow. Public by design: served at https://<domain>/<key>.txt
INDEXNOW_KEY=""

# Cloudflare Web Analytics. Dashboard -> Analytics -> Web Analytics -> the site's token.
# Chosen over GA4: no cookies, so no consent banner, and a fraction of the weight.
NEXT_PUBLIC_CF_BEACON_TOKEN=""

# Google AdSense. Empty until the account is approved; every ad renders nothing
# while it is, so a build without it ships clean pages.
NEXT_PUBLIC_ADSENSE_CLIENT=""
NEXT_PUBLIC_ADSENSE_SLOT_TOP=""
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=""

# Shown on /contact and in the privacy policy. Use an address meant to be public.
NEXT_PUBLIC_CONTACT_EMAIL=""

# Set to 1 when analytics is running, whichever way it was switched on. Cloudflare
# Pages can inject the beacon itself, in which case CF_BEACON_TOKEN stays empty and
# this flag is what tells the privacy policy to describe the analytics.
NEXT_PUBLIC_ANALYTICS_ENABLED=""
